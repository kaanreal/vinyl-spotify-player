[Unit]
Description=Vinyl Spotify Player
After=network-online.target sound.target raspotify.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vinyl-spotify-player
Environment="SDL_VIDEODRIVER=fbcon"
Environment="SDL_FBDEV=/dev/fb0"
ExecStart=/usr/bin/python3 /home/pi/vinyl-spotify-player/main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target