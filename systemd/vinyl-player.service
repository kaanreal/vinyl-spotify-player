[Unit]
Description=Vinyl Spotify Player
After=network.target sound.target raspotify.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vinyl-spotify-player
Environment="DISPLAY=:0"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/pi/vinyl-spotify-player/venv/bin/python -m app.main
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
